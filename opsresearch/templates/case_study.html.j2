<script>window.PATTERNS = {{ patterns_json | safe }};</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
<script type="module">
import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
mermaid.initialize({startOnLoad:true,theme:"neutral",fontFamily:"Geist"});
</script>
<script>
(function(){
 const P = window.PATTERNS, C = ["#51a2ff","#0007cd","#d4ff4a","#0f0f0f","#16a34a","#d97706","#dc2626","#a3a3a3","#8b5cf6","#38bdf8","#f78166"];
 if (window.Chart){
  Chart.defaults.font.family = "Geist, system-ui, sans-serif"; Chart.defaults.maintainAspectRatio = false;
  const bar=(id,obj,horiz)=>{const e=Object.entries(obj).sort((a,b)=>b[1]-a[1]);new Chart(document.getElementById(id),{type:"bar",data:{labels:e.map(x=>x[0]),datasets:[{data:e.map(x=>x[1]),backgroundColor:"#51a2ff",borderRadius:4}]},options:{indexAxis:horiz?"y":"x",plugins:{legend:{display:false}}}})};
  bar("c-auth",P.auth_counts,true);
  bar("c-block",P.blocker_counts,true);
  const ss=Object.entries(P.self_serve_counts);
  new Chart(document.getElementById("c-ss"),{type:"doughnut",data:{labels:ss.map(x=>x[0]),datasets:[{data:ss.map(x=>x[1]),backgroundColor:C}]},options:{plugins:{legend:{position:"right"}}}});
  const cats=P.by_category.map(c=>c.category);
  new Chart(document.getElementById("c-cat"),{type:"bar",data:{labels:cats,datasets:[
   {label:"self-serve",data:P.by_category.map(c=>c.self_serve_open),backgroundColor:"#16a34a"},
   {label:"gated",data:P.by_category.map(c=>c.gated),backgroundColor:"#dc2626"},
   {label:"unknown",data:P.by_category.map(c=>c.unknown),backgroundColor:"#a3a3a3"}]},options:{scales:{x:{stacked:true},y:{stacked:true}}}});
  const keys=["official","community","none","unknown"];
  new Chart(document.getElementById("c-mcp"),{type:"bar",data:{labels:["Existing MCP","In Composio"],datasets:
   keys.map((k,i)=>({label:k,data:[P.mcp_counts[k]||0,0],backgroundColor:C[i]})).concat(
   ["yes","no","unknown"].map((k,i)=>({label:"composio: "+k,data:[0,P.composio_counts[k]||0],backgroundColor:["#0007cd","#d4ff4a","#a3a3a3"][i]})))},
   options:{scales:{x:{stacked:true},y:{stacked:true}}}});
 }
 if (window.jQuery && jQuery.fn.dataTable){ new DataTable("#matrix-table",{pageLength:25,order:[[0,"asc"]]}); }
})();
</script>
</body>
</html>
