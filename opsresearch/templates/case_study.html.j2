code,.mono{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:.86em}
nav{position:sticky;top:0;z-index:10;background:#0f0f0f;color:#fff;padding:10px 24px;display:flex;gap:18px;flex-wrap:wrap;align-items:center}
